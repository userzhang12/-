# Source this file after copying it to .env. Keep .env untracked.
JINGXU_DEMO=1
# DATABASE_URL='postgresql+psycopg://jingxu:local-password@127.0.0.1:5432/jingxu'
# JINGXU_DATA=/path/to/persistent/data
# JINGXU_WORKSPACE_CODE=choose-a-long-private-provisioning-code
# JINGXU_WORKSPACE_QUOTA_CENTS=50000
# JINGXU_OPERATOR_EMAILS=operator@example.com
# JINGXU_OPERATOR_CODE=choose-a-separate-private-operator-code
# JINGXU_SECURE_COOKIE=1
# JINGXU_DOWNLOAD_KEY=choose-a-unique-random-signing-key
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# ARK_API_KEY=
# ARK_IMAGE_MODEL=
# ARK_VIDEO_MODEL=
# FLUX.1 Schnell for face-free backgrounds and props. Set only on a Workers Free account.
# JINGXU_CLOUDFLARE_FREE=1
# JINGXU_CLOUDFLARE_ACCOUNT_ID=
# JINGXU_CLOUDFLARE_API_TOKEN=
# Optional managed voice. Omit to use bundled offline Mandarin.
# JINGXU_TTS_URL=
# JINGXU_TTS_KEY=
# JINGXU_BGM_FILE=/path/to/licensed-audio.wav
# JINGXU_PRICES_CENTS='{"script":0,"frame":0,"product_frame":0,"static_clip":0,"dynamic_clip_sec":0,"export":0}'
# JINGXU_PRODUCT_SOURCES='{"https://merchant.example/item/123":"https://merchant.example/feeds/jingxu-123.json"}'
# JINGXU_TREND_SOURCES='{"https://publisher.example/trends":"https://publisher.example/feeds/jingxu.json"}'
