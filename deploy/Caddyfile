{$JINGXU_PUBLIC_HOST} {
	encode zstd gzip
	request_body {
		max_size 16MB
	}

	handle_path /desktop/* {
		root * /releases
		@versioned path *.exe *.blockmap
		header @versioned Cache-Control "public, max-age=31536000, immutable"
		header {
			?Cache-Control "no-store"
			X-Content-Type-Options nosniff
		}
		file_server
	}

	handle /api/* {
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	handle {
		rewrite / /download
		reverse_proxy web:3000
	}
}
