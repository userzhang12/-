# Cloud app credentials. Copy to service.env on the server.
# Set to 1 only on an isolated invitation-preview deployment.
JINGXU_INVITE_PREVIEW=0
# Optional public support inbox shown in the workbench.
JINGXU_SUPPORT_EMAIL=
# Optional password recovery relay. Use implicit TLS (465) or STARTTLS (587).
JINGXU_SMTP_HOST=
JINGXU_SMTP_PORT=465
JINGXU_SMTP_FROM=
JINGXU_SMTP_USER=
JINGXU_SMTP_PASSWORD=
# Provide a private signup code to the first workspace owner.
JINGXU_WORKSPACE_CODE=
# Optional separate operations account. Provision only if used.
JINGXU_OPERATOR_EMAILS=
JINGXU_OPERATOR_CODE=
# Local speech works without a key. Set these for real script and video generation.
DEEPSEEK_API_KEY=
ARK_API_KEY=
ARK_IMAGE_MODEL=
ARK_VIDEO_MODEL=
# Comma-separated exact HTTPS media hostnames returned by the provider.
JINGXU_MEDIA_HOSTS=
JINGXU_PRICES_CENTS=
# Private object store, using AWS-compatible credentials and explicit region.
S3_BUCKET=
S3_ENDPOINT_URL=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
